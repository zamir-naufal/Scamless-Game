theme_override_font_sizes/font_size = 18
text = "Phishing isn't a rare threat 3.4 billion emails are sent every day, and 43% of people who think they can spot one still fall for it. The damage goes  beyond money.  Victims lose confidence in digital platforms, withdraw    from the systems modern life depends on, and often   stay silent, which is why only 7% of scams get reported. 

Phishing doesn't just empty accounts  it erodes trust. Learning to pause, verify, and respond isn't a  niche skill it's something we all need in everyday life. The   pause you practiced here is the same one that protects     you out there."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 1
script = ExtResource("4_ub0kw")

